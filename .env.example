ARIOPS_APP_NAME=ariops
ARIOPS_ENVIRONMENT=development
ARIOPS_DATABASE_URL=postgresql+psycopg://ariops:ariops@localhost:5432/ariops
ARIOPS_KUBERNETES_TOOL_ADAPTER=real
ARIOPS_KUBERNETES_CONNECTION_MODE=kubeconfig
ARIOPS_KUBERNETES_CLUSTER_NAME=company-cluster
# Leave empty to use the default kubeconfig location.
ARIOPS_KUBERNETES_KUBECONFIG_PATH=
# Comma-separated namespace allowlist; use * to allow every namespace.
# An empty value denies all cluster reads.
ARIOPS_KUBERNETES_ALLOWED_NAMESPACES=payments
ARIOPS_KUBERNETES_REQUEST_TIMEOUT_SECONDS=10
ARIOPS_KUBERNETES_MAX_LOG_TAIL_LINES=200
